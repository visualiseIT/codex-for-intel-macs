{
  "name": "codex-desktop-intel",
  "version": "0.3.1",
  "private": true,
  "description": "A small Intel-compatible macOS desktop client for the Codex CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/visualiseIT/codex-for-intel-macs.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke-app-server.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "package:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "release:mac:x64": "npm run build && electron-builder --mac --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.visualiseit.codexforintelmacs",
    "productName": "Codex Desktop Intel",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "visualiseIT",
      "repo": "codex-for-intel-macs",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "identity": "Sunny Jacob (4T4YB6286N)",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Codex Desktop Intel uses the microphone only when you choose to dictate a prompt."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
